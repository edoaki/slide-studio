{
  "name": "slide-studio",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:renderer": "npm run build",
    "test:renderer": "npm run build && node --test dist/tests/renderer/*.test.js",
    "render:spike": "npm run build && node scripts/migration/render-spike.mjs",
    "build": "node scripts/build-renderer.mjs --clean && tsc && node scripts/build-renderer.mjs",
    "dev:desktop": "npm start",
    "browser": "npm run build && node scripts/dev-desktop.mjs --studio-browser",
    "cli": "npm run build && node scripts/cli.mjs",
    "setup:pandoc": "node scripts/setup-pandoc.mjs",
    "test": "npm run build && node --test --test-concurrency=4 dist/tests/ai/*.test.js dist/tests/renderer/*.test.js dist/tests/core/*.test.js dist/tests/desktop/*.test.js dist/tests/packaging/*.test.js dist/tests/bridge/*.test.js",
    "test:desktop": "npm run build && node --test dist/tests/desktop/*.test.js",
    "test:desktop:e2e": "npm run build && node --test --test-concurrency=1 dist/tests/e2e/*.test.js",
    "start": "npm run build && node scripts/dev-desktop.mjs",
    "dist:mac": "npm run build && node scripts/package-desktop.mjs --mac",
    "dist:win": "npm run build && node scripts/package-desktop.mjs --win",
    "test:bridge": "npm run build && node --test dist/tests/bridge/*.test.js",
    "test:bridge:e2e": "npm run build && node scripts/test-bridge.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "domhandler": "5.0.3",
    "htmlparser2": "10.1.0",
    "pdf-lib": "1.17.1",
    "tar": "7.5.23",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron-internal/extract-zip": "1.0.1",
    "@types/node": "24.19.2",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2"
  },
  "main": "dist/apps/desktop/main.js",
  "description": "Local slide editor and Electron desktop application",
  "author": "Slide Studio contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/edoaki/slide-studio.git"
  }
}
