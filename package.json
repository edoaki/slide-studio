{
  "name": "slide-studio",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:renderer": "node scripts/build-renderer.mjs --clean && tsc && node scripts/build-renderer.mjs",
    "test:renderer": "pnpm build:renderer && node --test dist/tests/renderer/*.test.js",
    "render:spike": "pnpm build:renderer && node scripts/migration/render-spike.mjs",
    "build": "pnpm build:renderer",
    "dev:desktop": "pnpm build && node scripts/dev-desktop.mjs",
    "setup:pandoc": "node scripts/setup-pandoc.mjs",
    "test": "pnpm build && node --test dist/tests/renderer/*.test.js dist/tests/core/*.test.js dist/tests/desktop/*.test.js",
    "test:desktop": "pnpm build && node --test dist/tests/desktop/*.test.js",
    "test:desktop:e2e": "pnpm build && node --test dist/tests/e2e/*.test.js"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "pdf-lib": "1.17.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.3.1",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
