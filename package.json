{
  "name": "slide-studio",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": ">=24.18.0 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:renderer": "node scripts/build-renderer.mjs --clean && tsc && node scripts/build-renderer.mjs",
    "test:renderer": "pnpm build:renderer && node --test dist/tests/renderer/*.test.js",
    "render:spike": "pnpm build:renderer && node scripts/migration/render-spike.mjs"
  },
  "dependencies": { "pdf-lib": "1.17.1" },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.3.1",
    "typescript": "7.0.2"
  },
  "pnpm": { "onlyBuiltDependencies": ["electron"] }
}
